<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta charset='UTF-8'/>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <meta content='IE=edge' http-equiv='X-UA-Compatible'/>

  <!-- SEO: Title -->
  <b:if cond='data:view.isSingleItem'>
    <title><data:blog.pageName/> | <data:blog.title/></title>
  <b:else/>
    <title><data:blog.pageTitle/></title>
  </b:if>

  <!-- SEO: Meta Description -->
  <b:if cond='data:view.isSingleItem'>
    <b:if cond='data:blog.metaDescription'>
      <meta expr:content='data:blog.metaDescription' name='description'/>
    <b:else/>
      <meta expr:content='data:blog.pageName + &quot; - Read this tutorial on &quot; + data:blog.title' name='description'/>
    </b:if>
  <b:else/>
    <meta content='DevOps, Cloud Computing, MLOps tutorials and guides. Learn Kubernetes, Docker, CI/CD, and more at codecloudworld.' name='description'/>
  </b:if>

  <!-- SEO: Canonical URL -->
  <link expr:href='data:blog.canonicalUrl' rel='canonical'/>

  <!-- SEO: Robots - noindex archive/search/label pages -->
  <b:if cond='data:view.isLabelSearch or data:view.isSearch or data:view.isArchive'>
    <meta content='noindex, follow' name='robots'/>
  <b:else/>
    <meta content='index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1' name='robots'/>
  </b:if>

  <!-- Open Graph -->
  <meta content='website' property='og:type'/>
  <meta expr:content='data:blog.pageTitle' property='og:title'/>
  <meta expr:content='data:blog.canonicalUrl' property='og:url'/>
  <meta expr:content='data:blog.title' property='og:site_name'/>
  <b:if cond='data:blog.postImageThumbnailUrl'>
    <meta expr:content='data:blog.postImageThumbnailUrl' property='og:image'/>
  </b:if>
  <b:if cond='data:blog.metaDescription'>
    <meta expr:content='data:blog.metaDescription' property='og:description'/>
  </b:if>

  <!-- Twitter Card -->
  <meta content='summary_large_image' name='twitter:card'/>
  <meta expr:content='data:blog.pageTitle' name='twitter:title'/>
  <b:if cond='data:blog.metaDescription'>
    <meta expr:content='data:blog.metaDescription' name='twitter:description'/>
  </b:if>
  <b:if cond='data:blog.postImageThumbnailUrl'>
    <meta expr:content='data:blog.postImageThumbnailUrl' name='twitter:image'/>
  </b:if>

  <!-- JSON-LD Structured Data -->
  <b:if cond='data:view.isHomepage'>
    <script type='application/ld+json'>
      {
        &quot;@context&quot;: &quot;https://schema.org&quot;,
        &quot;@type&quot;: &quot;WebSite&quot;,
        &quot;name&quot;: &quot;<data:blog.title/>&quot;,
        &quot;url&quot;: &quot;<data:blog.canonicalHomepageUrl/>&quot;,
        &quot;potentialAction&quot;: {
          &quot;@type&quot;: &quot;SearchAction&quot;,
          &quot;target&quot;: &quot;<data:blog.canonicalHomepageUrl/>search?q={search_term_string}&quot;,
          &quot;query-input&quot;: &quot;required name=search_term_string&quot;
        }
      }
    </script>
  </b:if>

  <b:if cond='data:view.isSingleItem'>
    <script type='application/ld+json'>
      {
        &quot;@context&quot;: &quot;https://schema.org&quot;,
        &quot;@type&quot;: &quot;BlogPosting&quot;,
        &quot;headline&quot;: &quot;<data:blog.pageName/>&quot;,
        &quot;url&quot;: &quot;<data:blog.canonicalUrl/>&quot;,
        &quot;publisher&quot;: {
          &quot;@type&quot;: &quot;Organization&quot;,
          &quot;name&quot;: &quot;<data:blog.title/>&quot;,
          &quot;url&quot;: &quot;<data:blog.canonicalHomepageUrl/>&quot;
        }
      }
    </script>
  </b:if>

  <b:include data='blog' name='all-head-content'/>

  <!-- Theme Color -->
  <meta content='#0f172a' name='theme-color'/>

  <!-- Favicon (SVG) -->
  <link href='data:image/svg+xml,&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 64 64&quot;&gt;&lt;path d=&quot;M52 34a12 12 0 00-11.4-12A16 16 0 0012 28a10 10 0 001 20h38a12 12 0 001-14z&quot; fill=&quot;%23ff1493&quot;/&gt;&lt;/svg&gt;' rel='icon' type='image/svg+xml'/>

  <!-- Preconnect Hints -->
  <link href='https://fonts.googleapis.com' rel='preconnect'/>
  <link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
  <link href='https://cdn.jsdelivr.net' rel='preconnect'/>
  <link href='https://cdnjs.cloudflare.com' rel='preconnect'/>

  <!-- Fonts (combined, with display=swap) -->
  <link href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Fira+Code:wght@400;500&amp;display=swap' rel='stylesheet'/>

  <!-- External CSS hosted on GitHub via jsDelivr CDN -->
  <link href='https://cdn.jsdelivr.net/gh/helloamitkr/theme-codecloudworld@main/css/theme.css' rel='stylesheet'/>

  <!-- Prism CSS - only on single post pages -->
  <b:if cond='data:view.isSingleItem'>
    <link href='https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css' rel='stylesheet'/>
  </b:if>

  <b:skin><![CDATA[
    #header-nav-section,
    #header-nav-section .widget,
    #header-nav-section > div,
    #LinkList1,
    #LinkList1 .widget-content,
    .header-nav-section,
    .header-nav-section .widget {
      background: transparent !important;
      border: none !important;
      margin: 0 !important;
      padding: 0 !important;
      box-shadow: none !important;
      border-radius: 0 !important;
    }
    #header-left,
    #header-left .widget {
      background: transparent !important;
      border: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    @media (max-width: 768px) {
      .container, .layout-wrapper.container {
        width: 100% !important;
        padding-left: 8px !important;
        padding-right: 8px !important;
      }
      .post {
        flex-direction: column !important;
        background: transparent !important;
        border: none !important;
        border-bottom: 1px solid #3f3f46 !important;
        border-radius: 0 !important;
        margin-bottom: 0 !important;
        box-shadow: none !important;
      }
      .post:last-child {
        border-bottom: none !important;
      }
      .post:hover {
        transform: none !important;
        box-shadow: none !important;
      }
      .post-thumbnail {
        width: 100% !important;
        min-height: 160px !important;
        max-height: 200px !important;
      }
      .post-content {
        padding: 16px 4px !important;
      }
      .post-title {
        font-size: 18px !important;
      }
      .post-meta {
        font-size: 13px !important;
      }
      .post-full {
        padding: 20px 12px !important;
        background: transparent !important;
        border: none !important;
      }
    }
    @media (max-width: 480px) {
      .container, .layout-wrapper.container {
        padding-left: 4px !important;
        padding-right: 4px !important;
      }
    }
  ]]></b:skin>

  <!-- Force desktop theme on mobile (our theme is already responsive) -->
  <script>
    //<![CDATA[
    if(window.location.search.indexOf('m=1')>-1){window.location.href=window.location.href.replace(/([?&])m=1/,'$1m=0');}
    //]]>
  </script>
</head>
<body>

  <!-- Header Section -->
  <header class='site-header professional-header'>
    <div class='header-inner'>
      <div class='header-left-col'>
        <b:section class='header-left' id='header-left' maxwidgets='1' showaddelement='no'>
          <b:widget id='Header1' locked='true' title='Blog Header' type='Header' version='1'>
            <b:includable id='main'>
              <div class='site-title'>
                <a expr:href='data:blog.homepageUrl'>
                  <svg class='site-logo-svg' viewBox='0 0 64 64' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M52 34a12 12 0 00-11.4-12A16 16 0 0012 28a10 10 0 001 20h38a12 12 0 001-14z' fill='#ff1493'/><path d='M30 36l-4 4m0 0l-4-4m4 4V28' stroke='#fff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/><path d='M42 36l-4 4m0 0l-4-4m4 4V28' stroke='#fff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' opacity='0.6'/></svg>
                  <span>codecloudworld</span>
                </a>
              </div>
            </b:includable>
          </b:widget>
        </b:section>
      </div>

      <div class='mobile-menu-toggle' id='mobileMenuBtn'>
        <svg fill='none' height='26' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='26'><line x1='3' x2='21' y1='12' y2='12'/><line x1='3' x2='21' y1='6' y2='6'/><line x1='3' x2='21' y1='18' y2='18'/></svg>
      </div>
      
      <div class='mobile-overlay' id='mobileOverlay'></div>

      <div class='header-right-col' id='headerRightCol'>
        <div class='mobile-close-btn' id='mobileCloseBtn'>
           <svg fill='none' height='26' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='26'><line x1='18' x2='6' y1='6' y2='18'/><line x1='6' x2='18' y1='6' y2='18'/></svg>
        </div>
        <b:section class='header-nav-section' id='header-nav-section' maxwidgets='1' showaddelement='yes'>
          <b:widget id='LinkList1' locked='false' title='Navigation Menu' type='LinkList' version='2'>
            <b:includable id='main'>
              <nav class='header-nav custom-nav' aria-label='Main navigation'>
                <ul>
                  <b:loop values='data:links' var='link'>
                    <li>
                      <a expr:href='data:link.target'><data:link.name/></a>
                    </li>
                  </b:loop>
                </ul>
              </nav>
            </b:includable>
          </b:widget>
        </b:section>
        <div class='header-actions'>
          <a aria-label='Search this site' class='search-icon' href='/search' title='Search'>
            <svg fill='none' height='20' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='20'><circle cx='11' cy='11' r='8'/><line x1='21' x2='16.65' y1='21' y2='16.65'/></svg>
          </a>
        </div>
      </div>
    </div>
  </header>

  <div class='layout-wrapper container'>
    
    <!-- Main Content (Blog Posts) -->
    <main class='main-content'>
      <b:if cond='data:view.isHomepage'>
        <div class='blog-section-header'>
          <h2>Blog</h2>
          <a href='/search'>View All &#8594;</a>
        </div>
      </b:if>

      <b:section class='main' id='main' showaddelement='no'>
        <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='1'>
          <b:includable id='main' var='top'>
            <b:if cond='data:view.isSingleItem'>
              <b:loop values='data:posts' var='post'>
                <b:include data='post' name='post-full'/>
              </b:loop>
            <b:else/>
              <!-- Posts Loop -->
              <div class='post-list'>
                <b:loop values='data:posts' var='post'>
                  <article class='post'>
                    <div class='post-thumbnail'>
                      <b:if cond='data:post.firstImageUrl'>
                        <img expr:alt='data:post.title' expr:src='data:post.firstImageUrl' loading='lazy'/>
                      <b:else/>
                        <svg fill='none' height='48' stroke='currentColor' stroke-width='1.5' viewBox='0 0 24 24' width='48'><path d='M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z' stroke-linecap='round' stroke-linejoin='round'/></svg>
                      </b:if>
                    </div>
                    <div class='post-content'>
                      <h2 class='post-title'>
                        <b:if cond='data:post.url'>
                          <a expr:href='data:post.url'><data:post.title/></a>
                        <b:else/>
                          <data:post.title/>
                        </b:if>
                      </h2>
                      <div class='post-meta'>
                        <span>&#128197; <data:post.date/></span>
                        <b:if cond='data:post.author'>
                          <span>&#9997; <data:post.author/></span>
                        </b:if>
                      </div>
                      <div class='post-body'>
                        <b:if cond='data:post.snippet'>
                          <p><data:post.snippet/></p>
                          <div>
                            <a class='read-more-btn' expr:href='data:post.url'>Read Tutorial &#8594;</a>
                          </div>
                        <b:else/>
                           <p><data:post.body/></p>
                        </b:if>
                      </div>
                    </div>
                  </article>
                </b:loop>
              </div>
            </b:if>
            
            <!-- Pagination -->
            <b:include name='nextprev'/>
          </b:includable>

          <b:includable id='post-full' var='post'>
            <article class='post-full'>
              <header class='post-full-header'>
                <h1 class='post-full-title'><data:post.title/></h1>
                <div class='post-meta'>
                  <span>&#128197; <data:post.date/></span>
                  <b:if cond='data:post.author'>
                    <span>&#9997; <data:post.author/></span>
                  </b:if>
                </div>
              </header>

              <div class='post-full-content post-body'>
                <data:post.body/>
                <div class='post-labels'>
                  <b:loop values='data:post.labels' var='label'>
                    <a expr:href='data:label.url' rel='tag'><data:label.name/></a>
                  </b:loop>
                </div>
              </div>
            </article>
          </b:includable>
          
          <b:includable id='nextprev'>
            <div class='blog-pager' id='blog-pager'>
              <b:if cond='data:newerPageUrl'>
                <a class='blog-pager-newer-link' expr:href='data:newerPageUrl' id='blog-pager-newer-link'>&#8592; Newer Posts</a>
              </b:if>
              <b:if cond='data:olderPageUrl'>
                <a class='blog-pager-older-link' expr:href='data:olderPageUrl' id='blog-pager-older-link'>Older Posts &#8594;</a>
              </b:if>
            </div>
          </b:includable>
        </b:widget>
      </b:section>
    </main>

    <!-- Sidebar -->
    <aside class='sidebar-area'>
      <b:section class='sidebar' id='sidebar' preferred='yes'>
        
        <!-- Email Capture Widget -->
        <b:widget id='HTML1' locked='false' title='Weekly DevOps &amp; Tech Updates' type='HTML' version='1'>
          <b:includable id='main'>
            <div class='widget HTML'>
              <b:if cond='data:title != &quot;&quot;'>
                <h3 class='widget-title'><data:title/></h3>
              </b:if>
              <div class='widget-content'>
                <p style='margin-bottom: 15px; color: #9ca3af; font-size: 15px;'>Join our newsletter to get weekly hands-on tutorials and DevOps best practices.</p>
                <form action='#' method='post' style='display: flex; flex-direction: column; gap: 10px;'>
                  <input name='email' placeholder='Enter your email address' required='required' style='padding: 12px 15px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 15px; width: 100%; box-sizing: border-box; background: var(--bg-color); color: var(--text-color);' type='email'/>
                  <input style='background-color: var(--primary-color); color: white; border: none; padding: 12px 15px; border-radius: 6px; font-size: 15px; font-weight: 600; cursor: pointer; transition: background-color 0.2s;' type='submit' value='Subscribe Now'/>
                </form>
              </div>
            </div>
          </b:includable>
        </b:widget>
        
        <!-- Popular Posts Widget -->
        <b:widget id='PopularPosts1' locked='false' title='Popular Tutorials' type='PopularPosts' version='1'>
          <b:includable id='main'>
            <div class='widget PopularPosts'>
              <b:if cond='data:title != &quot;&quot;'>
                <h3 class='widget-title'><data:title/></h3>
              </b:if>
              <div class='widget-content'>
                <ul class='popular-posts-list'>
                  <b:loop values='data:posts' var='post'>
                    <li>
                      <a expr:href='data:post.href'><data:post.title/></a>
                    </li>
                  </b:loop>
                </ul>
              </div>
            </div>
          </b:includable>
        </b:widget>

        <!-- Labels / Categories Widget -->
        <b:widget id='Label1' locked='false' title='Tutorial Categories' type='Label' version='1'>
          <b:includable id='main'>
            <div class='widget'>
              <b:if cond='data:title != &quot;&quot;'>
                <h3 class='widget-title'><data:title/></h3>
              </b:if>
              <div class='widget-content list-label-widget-content'>
                <ul>
                  <b:loop values='data:labels' var='label'>
                    <li>
                      <a expr:dir='data:blog.languageDirection' expr:href='data:label.url'><data:label.name/></a>
                      <span dir='ltr'><data:label.count/></span>
                    </li>
                  </b:loop>
                </ul>
              </div>
            </div>
          </b:includable>
        </b:widget>

      </b:section>
    </aside>

  </div>

  <!-- Error Page -->
  <b:if cond='data:view.isError'>
    <div class='error-page'>
      <h1>404</h1>
      <p>The page you are looking for does not exist or has been moved.</p>
      <a expr:href='data:blog.homepageUrl'>Back to Home</a>
    </div>
  </b:if>

  <!-- Footer -->
  <footer class='site-footer'>
    <div class='container'>
      <div class='footer-grid'>
        <div class='footer-col footer-brand'>
          <a expr:href='data:blog.homepageUrl'>
            <svg class='site-logo-svg' viewBox='0 0 64 64' fill='none' xmlns='http://www.w3.org/2000/svg' style='height:28px;width:28px;'><path d='M52 34a12 12 0 00-11.4-12A16 16 0 0012 28a10 10 0 001 20h38a12 12 0 001-14z' fill='#ff1493'/><path d='M30 36l-4 4m0 0l-4-4m4 4V28' stroke='#fff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/><path d='M42 36l-4 4m0 0l-4-4m4 4V28' stroke='#fff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' opacity='0.6'/></svg>
          </a>
          <p>Join us for DevOps,Machine Learning,Cloud Computing,Agentic AI, Software Development &amp; MLOps community. Get weekly deep dives, handpicked tools, and AI NEWS.</p>
        </div>
        
        <div class='footer-col'>
          <h3>Resources</h3>
          <ul>
            <li><a href='#'>Projects</a></li>
            <li><a href='#'>Roadmaps</a></li>
            <li><a href='#'>Certification Guides</a></li>
            <li><a href='#'>Services</a></li>
          </ul>
        </div>

        <div class='footer-col'>
          <h3>Company</h3>
          <ul>
            <li><a href='#'>About Us</a></li>
            <li><a href='#'>Contact</a></li>
            <li><a href='#'>Advertise</a></li>
            <li><a href='#'>Privacy Policy</a></li>
          </ul>
        </div>
        
        <div class='footer-col'>
          <h3>Follow Us</h3>
          <ul>
            <li><a href='#'>Twitter</a></li>
            <li><a href='#'>LinkedIn</a></li>
            <li><a href='#'>GitHub</a></li>
            <li><a href='#'>YouTube</a></li>
          </ul>
        </div>
      </div>
      
      <div class='footer-bottom'>
        <p>© 2026 <data:blog.title/>. All rights reserved.</p>
        <p>Built by codecloud for the DevOps Community</p>
      </div>
    </div>
  </footer>

  <!-- Prism JS for Syntax Highlighting (only on post pages) -->
  <b:if cond='data:view.isSingleItem'>
    <script src='https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js'></script>
    <script src='https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-javascript.min.js'></script>
    <script src='https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-css.min.js'></script>
    <script src='https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js'></script>
    <script src='https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-python.min.js'></script>
    <script src='https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-markup.min.js'></script>
    <script src='https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-yaml.min.js'></script>
    <script src='https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-docker.min.js'></script>
  </b:if>
  
  <script>
    //<![CDATA[
    document.addEventListener('DOMContentLoaded', function() {
      var mobileBtn = document.getElementById('mobileMenuBtn');
      var closeBtn = document.getElementById('mobileCloseBtn');
      var overlay = document.getElementById('mobileOverlay');
      var headerRight = document.getElementById('headerRightCol');
      
      function toggleMenu() {
        if(headerRight.classList.contains('open')) {
          headerRight.classList.remove('open');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        } else {
          headerRight.classList.add('open');
          overlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }

      if(mobileBtn && closeBtn && overlay && headerRight) {
        mobileBtn.addEventListener('click', toggleMenu);
        closeBtn.addEventListener('click', toggleMenu);
        overlay.addEventListener('click', toggleMenu);
      }

    });
    //]]>
  </script>
</body>
</html>
