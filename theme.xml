<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta charset='UTF-8'/>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <title><data:blog.pageTitle/></title>
  <b:include data='blog' name='all-head-content'/>
  
  <!-- Fonts -->
  <link href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500' rel='stylesheet'/>
  
  <!-- Prism JS CSS -->
  <link href='https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css' rel='stylesheet'/>

  <!-- External CSS hosted on GitHub via jsDelivr CDN for faster loading -->
  <link href='https://cdn.jsdelivr.net/gh/helloamitkr/theme-codecloudworld@main/css/theme.css' rel='stylesheet'/>

  <b:skin><![CDATA[]]></b:skin>
</head>
<body>

  <!-- Header Section -->
  <header class='site-header professional-header'>
    <div class='header-inner'>
      <div class='header-left-col'>
        <b:section class='header-left' id='header-left' maxwidgets='1' showaddelement='no'>
          <b:widget id='Header1' locked='true' title='Blog Header' type='Header' version='1'>
            <b:includable id='main'>
              <div class='site-title'>
                <a expr:href='data:blog.homepageUrl'>
                  <svg class='site-logo-svg' viewBox='0 0 64 64' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M52 34a12 12 0 00-11.4-12A16 16 0 0012 28a10 10 0 001 20h38a12 12 0 001-14z' fill='#ff1493'/><path d='M30 36l-4 4m0 0l-4-4m4 4V28' stroke='#fff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/><path d='M42 36l-4 4m0 0l-4-4m4 4V28' stroke='#fff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' opacity='0.6'/></svg>
                  <span>codecloudworld</span>
                </a>
              </div>
            </b:includable>
          </b:widget>
        </b:section>
      </div>

      <div class='mobile-menu-toggle' id='mobileMenuBtn'>
        <svg fill='none' height='26' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='26'><line x1='3' x2='21' y1='12' y2='12'/><line x1='3' x2='21' y1='6' y2='6'/><line x1='3' x2='21' y1='18' y2='18'/></svg>
      </div>
      
      <div class='mobile-overlay' id='mobileOverlay'/>

      <div class='header-right-col' id='headerRightCol'>
        <div class='mobile-close-btn' id='mobileCloseBtn'>
           <svg fill='none' height='26' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='26'><line x1='18' x2='6' y1='6' y2='18'/><line x1='6' x2='18' y1='6' y2='18'/></svg>
        </div>
        <b:section class='header-nav-section' id='header-nav-section' maxwidgets='1' showaddelement='yes'>
          <b:widget id='LinkList1' locked='false' title='Navigation Menu' type='LinkList' version='2'>
            <b:includable id='main'>
              <nav class='header-nav custom-nav' aria-label='Main navigation'>
                <ul>
                  <b:loop values='data:links' var='link'>
                    <li>
                      <a expr:href='data:link.target'><data:link.name/></a>
                    </li>
                  </b:loop>
                </ul>
              </nav>
            </b:includable>
          </b:widget>
        </b:section>
        <div class='header-actions'>
          <a class='search-icon' href='#' title='Search'>
            <svg fill='none' height='20' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='20'><circle cx='11' cy='11' r='8'/><line x1='21' x2='16.65' y1='21' y2='16.65'/></svg>
          </a>
          <button class='pro-btn' id='subscribeBtn' type='button'>Subscribe</button>
        </div>
      </div>
    </div>
  </header>

  <b:if cond='data:view.isHomepage'>
    <section class='hero-section'>
      <div class='hero-inner'>
        <h1 class='hero-headline'>Become a Better <span class='hero-highlight'>DevOps/MLOps</span> Engineer</h1>
        <p class='hero-subheadline'>Join 250,000+ DevOps &amp; MLOps community. Get weekly deep dives, handpicked tools, and career resources. Trusted by 19,500+ newsletter subscribers.</p>
        <form action='#' class='hero-subscribe-form'>
          <input placeholder='Enter your email' required='true' type='email'/>
          <button type='submit'>Subscribe</button>
        </form>
      </div>
    </section>
  </b:if>

  <div class='layout-wrapper container'>
    
    <!-- Main Content (Blog Posts) -->
    <main class='main-content'>
      <b:if cond='data:view.isHomepage'>
        <div class='blog-section-header'>
          <h2>Blog</h2>
          <a href='/search'>View All &#8594;</a>
        </div>
      </b:if>

      <b:section class='main' id='main' showaddelement='no'>
        <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='1'>
          <b:includable id='main' var='top'>
            <b:if cond='data:view.isSingleItem'>
              <b:loop values='data:posts' var='post'>
                <b:include data='post' name='post-full'/>
              </b:loop>
            <b:else/>
              <!-- Posts Loop -->
              <div class='post-list'>
                <b:loop values='data:posts' var='post'>
                  <article class='post'>
                    <div class='post-thumbnail'>
                      <b:if cond='data:post.firstImageUrl'>
                        <img expr:alt='data:post.title' expr:src='data:post.firstImageUrl'/>
                      <b:else/>
                        <svg fill='none' height='48' stroke='currentColor' stroke-width='1.5' viewBox='0 0 24 24' width='48'><path d='M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z' stroke-linecap='round' stroke-linejoin='round'/></svg>
                      </b:if>
                    </div>
                    <div class='post-content'>
                      <h2 class='post-title'>
                        <b:if cond='data:post.url'>
                          <a expr:href='data:post.url'><data:post.title/></a>
                        <b:else/>
                          <data:post.title/>
                        </b:if>
                      </h2>
                      <div class='post-meta'>
                        <span>&#128197; <data:post.dateHeader/></span>
                        <b:if cond='data:post.author'>
                          <span>&#9997; <data:post.author/></span>
                        </b:if>
                      </div>
                      <div class='post-body'>
                        <b:if cond='data:post.snippet'>
                          <p><data:post.snippet/></p>
                          <div>
                            <a class='read-more-btn' expr:href='data:post.url'>Read Tutorial &#8594;</a>
                          </div>
                        <b:else/>
                           <p><data:post.body/></p>
                        </b:if>
                      </div>
                    </div>
                  </article>
                </b:loop>
              </div>
            </b:if>
            
            <!-- Pagination -->
            <b:include name='nextprev'/>
          </b:includable>

          <b:includable id='post-full' var='post'>
            <article class='post-full'>
              <header class='post-full-header'>
                <h1 class='post-full-title'><data:post.title/></h1>
                <div class='post-meta'>
                  <span>&#128197; <data:post.dateHeader/></span>
                  <b:if cond='data:post.author'>
                    <span>&#9997; <data:post.author/></span>
                  </b:if>
                </div>
              </header>

              <div class='post-full-content post-body'>
                <data:post.body/>
                <div class="post-labels">
                  <b:loop values='data:post.labels' var='label'>
                    <a expr:href='data:label.url' rel='tag'><data:label.name/></a>
                  </b:loop>
                </div>
              </div>
            </article>
          </b:includable>
          
          <b:includable id='nextprev'>
            <div class='blog-pager' id='blog-pager'>
              <b:if cond='data:newerPageUrl'>
                <a class='blog-pager-newer-link' expr:href='data:newerPageUrl' id='blog-pager-newer-link'>&#8592; Newer Posts</a>
              </b:if>
              <b:if cond='data:olderPageUrl'>
                <a class='blog-pager-older-link' expr:href='data:olderPageUrl' id='blog-pager-older-link'>Older Posts &#8594;</a>
              </b:if>
            </div>
          </b:includable>
        </b:widget>
      </b:section>
    </main>

    <!-- Sidebar -->
    <aside class='sidebar-area'>
      <b:section class='sidebar' id='sidebar' preferred='yes'>
        
        <!-- Email Capture Widget -->
        <b:widget id='HTML1' locked='false' title='Weekly DevOps &amp; Tech Updates' type='HTML' version='1'>
          <b:includable id='main'>
            <div class='widget HTML'>
              <b:if cond='data:title != &quot;&quot;'>
                <h3 class='widget-title'><data:title/></h3>
              </b:if>
              <div class='widget-content'>
                <p style='margin-bottom: 15px; color: #9ca3af; font-size: 15px;'>Join our newsletter to get weekly hands-on tutorials and DevOps best practices.</p>
                <form action='#' method='post' style='display: flex; flex-direction: column; gap: 10px;'>
                  <input name='email' placeholder='Enter your email address' required='required' style='padding: 12px 15px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 15px; width: 100%; box-sizing: border-box; background: var(--bg-color); color: var(--text-color);' type='email'/>
                  <input style='background-color: var(--primary-color); color: white; border: none; padding: 12px 15px; border-radius: 6px; font-size: 15px; font-weight: 600; cursor: pointer; transition: background-color 0.2s;' type='submit' value='Subscribe Now'/>
                </form>
              </div>
            </div>
          </b:includable>
        </b:widget>
        
        <!-- Popular Posts Widget -->
        <b:widget id='PopularPosts1' locked='false' title='Popular Tutorials' type='PopularPosts' version='1'>
          <b:includable id='main'>
            <div class='widget PopularPosts'>
              <b:if cond='data:title != &quot;&quot;'>
                <h3 class='widget-title'><data:title/></h3>
              </b:if>
              <div class='widget-content'>
                <ul class='popular-posts-list'>
                  <b:loop values='data:posts' var='post'>
                    <li>
                      <a expr:href='data:post.href'><data:post.title/></a>
                    </li>
                  </b:loop>
                </ul>
              </div>
            </div>
          </b:includable>
        </b:widget>

        <!-- Labels / Categories Widget -->
        <b:widget id='Label1' locked='false' title='Tutorial Categories' type='Label' version='1'>
          <b:includable id='main'>
            <div class='widget'>
              <b:if cond='data:title != &quot;&quot;'>
                <h3 class='widget-title'><data:title/></h3>
              </b:if>
              <div class='widget-content list-label-widget-content'>
                <ul>
                  <b:loop values='data:labels' var='label'>
                    <li>
                      <a expr:dir='data:blog.languageDirection' expr:href='data:label.url'><data:label.name/></a>
                      <span dir='ltr'><data:label.count/></span>
                    </li>
                  </b:loop>
                </ul>
              </div>
            </div>
          </b:includable>
        </b:widget>

      </b:section>
    </aside>

  </div>

  <!-- Error Page -->
  <b:if cond='data:view.isError'>
    <div class='error-page'>
      <h1>404</h1>
      <p>The page you are looking for does not exist or has been moved.</p>
      <a expr:href='data:blog.homepageUrl'>Back to Home</a>
    </div>
  </b:if>

  <!-- Footer -->
  <footer class='site-footer'>
    <div class='container'>
      <div class='footer-grid'>
        <div class='footer-col footer-brand'>
          <a expr:href='data:blog.homepageUrl'>
            <svg class='site-logo-svg' viewBox='0 0 64 64' fill='none' xmlns='http://www.w3.org/2000/svg' style='height:28px;width:28px;'><path d='M52 34a12 12 0 00-11.4-12A16 16 0 0012 28a10 10 0 001 20h38a12 12 0 001-14z' fill='#ff1493'/><path d='M30 36l-4 4m0 0l-4-4m4 4V28' stroke='#fff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'/><path d='M42 36l-4 4m0 0l-4-4m4 4V28' stroke='#fff' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' opacity='0.6'/></svg>
          </a>
          <p>Join 250,000+ DevOps &amp; MLOps community. Get weekly deep dives, handpicked tools, and career resources.</p>
        </div>
        
        <div class='footer-col'>
          <h3>Resources</h3>
          <ul>
            <li><a href='#'>Tutorials</a></li>
            <li><a href='#'>Roadmaps</a></li>
            <li><a href='#'>Certification Guides</a></li>
            <li><a href='#'>Newsletter</a></li>
          </ul>
        </div>

        <div class='footer-col'>
          <h3>Company</h3>
          <ul>
            <li><a href='#'>About Us</a></li>
            <li><a href='#'>Contact</a></li>
            <li><a href='#'>Advertise</a></li>
            <li><a href='#'>Privacy Policy</a></li>
          </ul>
        </div>
        
        <div class='footer-col'>
          <h3>Follow Us</h3>
          <ul>
            <li><a href='#'>Twitter</a></li>
            <li><a href='#'>LinkedIn</a></li>
            <li><a href='#'>GitHub</a></li>
            <li><a href='#'>YouTube</a></li>
          </ul>
        </div>
      </div>
      
      <div class='footer-bottom'>
        <p>&amp;copy; 2026 <data:blog.title/>. All rights reserved.</p>
        <p>Built by codecloud for the DevOps Community</p>
      </div>
    </div>
  </footer>

  <!-- Subscribe Modal -->
  <div class='modal-overlay' id='subscribeModal'>
    <div class='modal-box'>
      <button class='modal-close' id='modalCloseBtn' type='button'>
        <svg fill='none' height='24' stroke='currentColor' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' viewBox='0 0 24 24' width='24'><line x1='18' x2='6' y1='6' y2='18'/><line x1='6' x2='18' y1='6' y2='18'/></svg>
      </button>
      <h2 class='modal-title'>Stay Connected</h2>
